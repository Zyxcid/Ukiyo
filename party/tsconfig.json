{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    // workers-types global (Request, WebSocket, DurableObjectNamespace, dst.)
    // tanpa lib "dom" agar tidak bentrok dengan tsconfig aplikasi Next.js
    "types": ["@cloudflare/workers-types"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["server.ts"]
}
