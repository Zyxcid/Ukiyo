# ============================================================
# zyxcid — ukiyo · contoh environment
# Salin file ini jadi `.env.local` lalu isi sesuai kebutuhan.
# ============================================================

# --- MULTIPLAYER (opsional; kosong = mode solo penuh) ---
# Alamat server PartyServer (Cloudflare Worker) tempat tamu-tamu lain "bertemu".
# Setelah `npm run party:login` + `npm run party:deploy`, salin alamat yang
# tercetak di output wrangler, contoh:
#   NEXT_PUBLIC_PARTY_HOST=ukiyo.nama-akun-kamu.workers.dev
# Untuk uji lokal (server `npm run party:dev` berjalan di 127.0.0.1:1999):
#   NEXT_PUBLIC_PARTY_HOST=127.0.0.1:1999
NEXT_PUBLIC_PARTY_HOST=
