# ============================================================
# zyxcid — ukiyo · contoh environment
# Salin file ini jadi `.env.local` lalu isi sesuai kebutuhan.
# ============================================================

# --- MULTIPLAYER (opsional; kosong = mode solo penuh) ---
# Alamat server PartyKit tempat tamu-tamu lain "bertemu".
# Setelah menjalankan `npx partykit deploy`, salin alamat yang tercetak, contoh:
#   NEXT_PUBLIC_PARTYKIT_HOST=ukiyo.nama-kamu.partykit.party
# Untuk uji lokal (server `npm run party:dev` berjalan di 127.0.0.1:1999):
#   NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999
NEXT_PUBLIC_PARTYKIT_HOST=
